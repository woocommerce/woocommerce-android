<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.woocommerce.android.ui.compose.designsystem.component.WooDesignSystemToolbar
        android:id="@+id/woo_ds_toolbar_scroll_target_test_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/woo_ds_toolbar_height"
        app:wooToolbarScrollTarget="@id/woo_ds_toolbar_scroll_target_test_target" />

    <ScrollView
        android:id="@+id/woo_ds_toolbar_scroll_target_test_decoy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="2000dp" />

    </ScrollView>

    <ScrollView
        android:id="@+id/woo_ds_toolbar_scroll_target_test_target"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="2000dp" />

    </ScrollView>

</LinearLayout>
