        },
        {
          "type": "ASSISTANT_TEXT_NOT_CONTAINS",
          "value": "wp admin"
        },
        {
          "type": "ASSISTANT_TEXT_NOT_CONTAINS",
          "value": "dashboard"
        },
        {
          "type": "ASSISTANT_TEXT_NOT_CONTAINS",
          "value": "dashboards"
        }
      ],
      "iosHard": {
        "t1": {
          "required_tools": [
            "orders_list"
          ],
          "required_tools_any": [
            "show_cards"
          ],
          "forbidden_tools": [
            "orders_get"
          ],
