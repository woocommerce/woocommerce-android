    {
      "id": "write_note_then_status",
      "category": "write",
      "scope": "GLOBAL",
      "smokeFixture": null,
      "turns": [
        {
          "userMessage": "add internal note to order 1230 \"customer called, needs gift wrap\"",
          "hardChecks": [
            {
              "type": "TOOL_CALLED",
              "value": "orders_update"
