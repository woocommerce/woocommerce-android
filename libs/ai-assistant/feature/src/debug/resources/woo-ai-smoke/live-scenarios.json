      "category": "read",
      "scope": "GLOBAL",
      "smokeFixture": null,
      "turns": [
        {
          "userMessage": "latest 5 orders please",
          "hardChecks": [
            {
              "type": "TOOL_CALLED",
              "value": "orders_list"
            },
            {
              "type": "TOOL_CALLED_ANY",
              "value": "show_cards"
            },
            {
              "type": "TOOL_NOT_CALLED",
              "value": "orders_get"
