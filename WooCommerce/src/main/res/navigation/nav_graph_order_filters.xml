<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_order_filters"
    app:startDestination="@id/orderFilterCategoriesFragment">
    <include app:graph="@navigation/nav_graph_product_selector" />
    <fragment
        android:id="@+id/orderFilterCategoriesFragment"
        android:name="com.woocommerce.android.ui.orders.filters.OrderFilterCategoriesFragment"
        tools:layout="@layout/fragment_order_filter_list">
        <action
            android:id="@+id/action_orderFilterListFragment_to_orderFilterOptionListFragment"
            app:destination="@id/orderFilterOptionsFragment"
            app:enterAnim="@anim/default_enter_anim"
            app:exitAnim="@anim/default_exit_anim"
            app:popEnterAnim="@anim/default_pop_enter_anim"
            app:popExitAnim="@anim/default_pop_exit_anim" />
        <action
            android:id="@+id/action_orderFilterCategoriesFragment_to_customerListFragment"
            app:destination="@id/orderFilterCustomerListFragment"
            app:enterAnim="@anim/default_enter_anim"
            app:exitAnim="@anim/default_exit_anim"
            app:popEnterAnim="@anim/default_pop_enter_anim"
            app:popExitAnim="@anim/default_pop_exit_anim" />
        <action
            android:id="@+id/action_orderFilterCategoriesFragment_to_filterHistoryFragment"
            app:destination="@id/orderFilterHistoryFragment"
            app:enterAnim="@anim/default_enter_anim"
            app:exitAnim="@anim/default_exit_anim"
            app:popEnterAnim="@anim/default_pop_enter_anim"
            app:popExitAnim="@anim/default_pop_exit_anim" />
        <action
            android:id="@+id/action_orderFilterCategoriesFragment_to_nav_graph_product_selector"
            app:destination="@id/nav_graph_product_selector"
            app:enterAnim="@anim/default_enter_anim"
            app:exitAnim="@anim/default_exit_anim"
            app:popEnterAnim="@anim/default_pop_enter_anim"
            app:popExitAnim="@anim/default_pop_exit_anim">
            <argument
                android:name="selectionMode"
                app:argType="com.woocommerce.android.ui.products.selector.ProductSelectorViewModel$SelectionMode" />
            <argument
                android:name="selectionHandling"
                app:argType="com.woocommerce.android.ui.products.selector.ProductSelectorViewModel$SelectionHandling" />
            <argument
                android:name="screenTitleOverride"
                app:argType="string" />
            <argument
                android:name="ctaButtonTextOverride"
                app:argType="string" />
            <argument
                android:name="selectedItems"
                android:defaultValue="@null"
                app:argType="com.woocommerce.android.ui.products.selector.ProductSelectorViewModel$SelectedItem[]"
                app:nullable="true" />
            <argument
                android:name="productSelectorFlow"
                app:argType="com.woocommerce.android.ui.products.selector.ProductSelectorViewModel$ProductSelectorFlow" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/orderFilterOptionsFragment"
        android:name="com.woocommerce.android.ui.orders.filters.OrderFilterOptionsFragment"
        tools:layout="@layout/fragment_order_filter_list">
        <argument
            android:name="filterCategory"
            app:argType="com.woocommerce.android.ui.orders.filters.model.OrderFilterCategoryUiModel"
            app:nullable="false" />
    </fragment>
    <fragment
        android:id="@+id/orderFilterCustomerListFragment"
        android:name="com.woocommerce.android.ui.orders.creation.customerlist.OrderCustomerListFragment"
        android:label="orderFilterCustomerListFragment">
        <argument
            android:name="allowCustomerCreation"
            app:argType="boolean" />
        <argument
            android:name="allowGuests"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/orderFilterHistoryFragment"
        android:name="com.woocommerce.android.ui.filters.FilterHistoryFragment"
        android:label="FilterHistoryFragment">
        <argument
            android:name="filterType"
            app:argType="com.woocommerce.android.ui.filters.FilterHistoryType" />
    </fragment>
</navigation>
