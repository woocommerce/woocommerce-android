<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/major_150"
        android:paddingTop="@dimen/major_150"
        android:paddingEnd="@dimen/major_150"
        android:text="@string/ai_support_chat_escalation_consent_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/text_major_25" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/major_150"
        android:paddingTop="@dimen/minor_100"
        android:paddingEnd="@dimen/major_150"
        android:paddingBottom="@dimen/major_100"
        android:text="@string/ai_support_chat_escalation_consent_message"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/text_minor_125" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/minor_10"
        android:background="@color/divider_color" />

    <TextView
        android:id="@+id/send_request"
        android:layout_width="match_parent"
        android:layout_height="@dimen/major_325"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/ai_support_chat_escalation_consent_send_request"
        android:textAllCaps="true"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_minor_125"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/minor_10"
        android:background="@color/divider_color" />

    <TextView
        android:id="@+id/contact_form"
        android:layout_width="match_parent"
        android:layout_height="@dimen/major_325"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/ai_support_chat_escalation_consent_contact_form"
        android:textAllCaps="true"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_minor_125"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/minor_10"
        android:background="@color/divider_color" />

    <TextView
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/major_325"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/cancel"
        android:textAllCaps="true"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_minor_125"
        android:textStyle="bold" />

</LinearLayout>
