<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.Woo.DesignSystem.Xml" parent="ThemeOverlay.MaterialComponents">
        <item name="colorPrimary">@color/design_system_primary</item>
        <item name="colorPrimaryVariant">@color/woo_purple_60</item>
        <item name="colorSecondary">@color/woo_purple_5</item>
        <item name="colorSecondaryVariant">@color/woo_purple_10</item>
        <item name="colorOnPrimary">@color/woo_white</item>
        <item name="colorOnSecondary">@color/design_system_primary</item>

        <item name="android:colorBackground">@color/design_system_background_section</item>
        <item name="colorSurface">@color/design_system_surface_default</item>
        <item name="colorOnSurface">@color/design_system_surface_on_default</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorAccent">@color/design_system_primary</item>
        <item name="colorControlNormal">@color/design_system_primary</item>
        <item name="android:colorControlActivated">@color/design_system_primary</item>

        <item name="textAppearanceSubtitle1">@style/TextAppearance.Woo.Subtitle1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Woo.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Woo.Caption</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Theme.Woo.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Theme.Woo.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Theme.Woo.LargeComponent</item>

        <item name="switchStyle">@style/Woo.Switch</item>
        <item name="android:listDivider">@drawable/list_divider</item>
        <item name="settingsToggleOptionStyle">@style/Widget.Woo.Settings.OptionToggle</item>
        <item name="settingsOptionValueStyle">@style/Widget.Woo.Settings.OptionValue</item>
        <item name="settingsCategoryHeaderStyle">@style/Widget.Woo.Settings.CategoryHeader</item>
        <item name="settingsButtonStyle">@style/Widget.Woo.Settings.Button</item>
    </style>

    <style name="ThemeOverlay.Woo.DesignSystem.Toolbar" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface">
        <item name="toolbarStyle">@style/Widget.Woo.Toolbar.DesignSystem</item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.Woo.ToolbarNavigationButton.DesignSystem</item>
        <item name="actionButtonStyle">@style/Widget.Woo.ToolbarActionButton.DesignSystem</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Woo.ToolbarOverflowButton.DesignSystem</item>
        <item name="actionMenuTextColor">@color/design_system_primary</item>
        <item name="actionMenuTextAppearance">@style/TextAppearance.Woo.ToolbarAction.DesignSystem</item>
        <item name="colorControlNormal">@color/design_system_surface_on_default</item>
    </style>

    <style name="ThemeOverlay.Woo.DesignSystem.Toolbar.Surface" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface">
        <item name="toolbarNavigationButtonStyle">@style/Widget.Woo.ToolbarNavigationButton.DesignSystem</item>
        <item name="actionButtonStyle">@style/Widget.Woo.ToolbarActionButton.DesignSystem</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Woo.ToolbarOverflowButton.DesignSystem</item>
        <item name="actionMenuTextColor">@color/design_system_primary</item>
        <item name="actionMenuTextAppearance">@style/TextAppearance.Woo.ToolbarAction.DesignSystem</item>
        <item name="colorControlNormal">@color/design_system_surface_on_default</item>
    </style>

    <style name="Widget.Woo.Toolbar.DesignSystem" parent="Widget.Woo.Toolbar">
        <item name="android:theme">@style/ThemeOverlay.Woo.DesignSystem.Toolbar.Surface</item>
        <item name="android:background">@color/design_system_surface_default</item>
        <item name="backgroundTint">@color/design_system_surface_default</item>
        <item name="android:minHeight">@dimen/design_system_toolbar_height</item>
        <item name="minHeight">@dimen/design_system_toolbar_height</item>
        <item name="titleCentered">true</item>
        <item name="titleTextStyle">@style/TextAppearance.Woo.ToolbarTitle.DesignSystem</item>
        <item name="navigationIconTint">@color/design_system_surface_on_default</item>
    </style>

    <style name="Widget.Woo.ToolbarNavigationButton.DesignSystem" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:layout_width">@dimen/design_system_toolbar_button_size</item>
        <item name="android:layout_height">@dimen/design_system_toolbar_button_size</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:minWidth">@dimen/design_system_toolbar_button_size</item>
        <item name="android:minHeight">@dimen/design_system_toolbar_button_size</item>
        <item name="android:background">@drawable/ds_toolbar_outlined_button_bg</item>
        <item name="background">@drawable/ds_toolbar_outlined_button_bg</item>
        <item name="tint">@color/design_system_surface_on_default</item>
        <item name="android:tint">@color/design_system_surface_on_default</item>
    </style>

    <style name="Widget.Woo.ToolbarActionButton.DesignSystem" parent="Widget.AppCompat.ActionButton">
        <item name="android:layout_width">@dimen/design_system_toolbar_button_size</item>
        <item name="android:layout_height">@dimen/design_system_toolbar_button_size</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:minWidth">@dimen/design_system_toolbar_button_size</item>
        <item name="android:minHeight">@dimen/design_system_toolbar_button_size</item>
        <item name="android:background">@drawable/ds_toolbar_outlined_button_bg</item>
        <item name="background">@drawable/ds_toolbar_outlined_button_bg</item>
        <item name="tint">@color/design_system_primary</item>
        <item name="android:tint">@color/design_system_primary</item>
    </style>

    <style name="Widget.Woo.ToolbarOverflowButton.DesignSystem" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">@drawable/ds_toolbar_outlined_button_bg</item>
        <item name="background">@drawable/ds_toolbar_outlined_button_bg</item>
        <item name="tint">@color/design_system_primary</item>
        <item name="android:tint">@color/design_system_primary</item>
    </style>

    <style name="TextAppearance.Woo.ToolbarTitle.DesignSystem" parent="TextAppearance.Woo.Subtitle1">
        <item name="android:textColor">@color/design_system_surface_on_default</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Woo.ToolbarAction.DesignSystem" parent="TextAppearance.Woo.Button">
        <item name="android:textColor">@color/design_system_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
