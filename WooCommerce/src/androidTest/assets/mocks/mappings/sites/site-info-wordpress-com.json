{
  "request": {
    "method": "GET",
    "urlPath": "/rest/v1.1/connect/site-info/",
    "queryParameters": {
      "url": {
        "matches": "(.*)"
      }
    }
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "exists": true,
      "isWordPress": "{{#contains request.query.url 'sitewithnowp.com'}}false{{else}}true{{/contains}}",
      "hasJetpack": "{{#contains request.query.url 'sitewithnowp.com'}}false{{else}}true{{/contains}}",
      "isJetpackActive": "{{#contains request.query.url 'sitewithnowp.com'}}false{{else}}true{{/contains}}",
      "isJetpackConnected": "{{#contains request.query.url 'sitewithnowp.com'}}false{{else}}true{{/contains}}",
      "isWordPressDotCom": "{{#contains request.query.url 'sitewithnowp.com'}}false{{else}}true{{/contains}}",
      "urlAfterRedirects": "{{#contains request.query.url 'sitewithnowp.com'}}https://sitewithnowp.com{{else}}https://automatticwidgets.wpcomstaging.com{{/contains}}",
      "jetpackVersion": false
    },
    "headers": {
      "Content-Type": "application/json",
      "Connection": "keep-alive",
      "Cache-Control": "no-cache, must-revalidate, max-age=0"
    },
    "transformers": ["response-template"]
  }
}
