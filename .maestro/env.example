# WooCommerce Android Maestro Smoke Tests - Environment Variables
#
# Variables prefixed with MAESTRO_ are automatically available in all
# flows and subflows as ${VAR_NAME} (without the prefix).
# E.g., MAESTRO_WOO_EMAIL -> ${WOO_EMAIL}
#
# Quick start:
#   1. Copy this file to .maestro/.env (gitignored)
#   2. Fill in your credentials (see Secret Store links below)
#   3. Run: ./scripts/run-maestro-local.sh .maestro/flows/login_successful.yaml
#
# Or export them in your shell:
#
#   export MAESTRO_WOO_EMAIL="your-email@example.com"
#   export MAESTRO_WOO_PASSWORD="your-password"
#   export MAESTRO_WOO_STORE_URL="https://your-store.example.com"
#
# Or pass them directly to maestro (without prefix):
#
#   maestro test -e WOO_EMAIL="..." -e WOO_PASSWORD="..." -e WOO_STORE_URL="..." .maestro/
#
# Credential sources:
#   - Primary credentials (appstestadmin): https://mc.a8c.com/secret-store/?secret_id=8326

# ─── Primary store (Jetpack-connected, used by most flows) ───
# Required for: login_successful, dashboard, orders, products, hub menu, blaze, google for woo, POS
MAESTRO_WOO_STORE_URL=https://inpersonpayments.wpcomstaging.com
MAESTRO_WOO_EMAIL=appstestadmin
MAESTRO_WOO_PASSWORD=your-password

# ─── Not-a-Woo-store login scenario ───
# Required for: login_not_woo_store
# Uses a WordPress.com site that does not have WooCommerce installed.
MAESTRO_WOO_NOT_WOO_STORE_URL=https://notawoostore.wordpress.com
MAESTRO_WOO_NOT_WOO_EMAIL=appstestadmin
MAESTRO_WOO_NOT_WOO_PASSWORD=your-password

# ─── Wrong-account-for-store login scenario ───
# Required for: login_wrong_account
# Uses a store URL where the provided account does not have access.
MAESTRO_WOO_WRONG_ACCOUNT_STORE_URL=https://site-for-woocommerce12a3fasdf45dfs6789.mystagingwebsite.com
MAESTRO_WOO_WRONG_ACCOUNT_EMAIL=appstestadmin
MAESTRO_WOO_WRONG_ACCOUNT_PASSWORD=your-password

# ─── Jetpack-specific store (optional) ───
# Required for: login_jetpack (optional separate flow)
# If the login flow asks for 2FA, unlock the account at:
#   https://mc.a8c.com/tools/reportcard/user/?id=209835171
MAESTRO_WOO_JETPACK_STORE_URL=https://jetpackwoostore.wpcomstaging.com
MAESTRO_WOO_JETPACK_EMAIL=appstestadmin
MAESTRO_WOO_JETPACK_PASSWORD=your-password

# ─── Optional ───
MAESTRO_WOO_CUSTOMER_NAME=John Doe
