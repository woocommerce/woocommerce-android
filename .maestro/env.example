# WooCommerce Android Maestro Smoke Tests - Environment Variables
#
# Copy this file to .env and fill in the values, or export them in your shell:
#
#   export MAESTRO_WOO_EMAIL="your-email@example.com"
#   export MAESTRO_WOO_PASSWORD="your-password"
#   export MAESTRO_WOO_STORE_URL="https://your-store.example.com"
#
# Or pass them directly to maestro:
#
#   maestro test -e WOO_EMAIL="..." -e WOO_PASSWORD="..." -e WOO_STORE_URL="..." .maestro/flows/
#
# Variables prefixed with MAESTRO_ are automatically available in flows
# without the prefix. E.g., MAESTRO_WOO_EMAIL -> ${WOO_EMAIL}

# Required: WordPress.com account credentials for the test store
WOO_EMAIL=your-email@example.com
WOO_PASSWORD=your-password

# Required: The WooCommerce store URL to log into
WOO_STORE_URL=https://your-store.wpcomstaging.com

# Optional: Customer name to use when creating orders
WOO_CUSTOMER_NAME=John Doe
