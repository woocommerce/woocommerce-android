# ─────────────────────────────────────────────────────────────────────────
# WooCommerce Android — Maestro smoke-test environment variables
# ─────────────────────────────────────────────────────────────────────────
#
# The runner passes MAESTRO_* values to Maestro with the MAESTRO_ prefix
# stripped, so MAESTRO_WOO_EMAIL is referenced inside YAML as ${WOO_EMAIL}.
#
# Setup:
#   1. Copy this file:   cp .maestro/env.example .maestro/.env.local
#   2. Fill in values (see secret-store links below).
#   3. Load before running flows:
#        set -a && source .maestro/.env.local && set +a
#        .maestro/scripts/run-smoke-tests.sh
#
# Or pass inline:
#   maestro test -e WOO_EMAIL=… -e WOO_PASSWORD=… .maestro/flows/
#
# P2 reference (login scenarios + test store mapping):
#   https://woomobilep2.wordpress.com/flows-for-app-features-smoke-testing/
#
# NEVER commit filled-in credentials. .env.local is git-ignored.
# Credentials should be copied directly by a human from the canonical secret
# store into .maestro/.env.local or Buildkite secrets. Do not paste them into
# agent conversations.


# ═════════════════════════════════════════════════════════════════════════
# REQUIRED STORE BLOCKS
# ═════════════════════════════════════════════════════════════════════════
# The developer CLI defaults to --store lab. Shared-store runs require
# --store shared and are intended for release-tool and Thursday burst usage.
#
# Each store block needs only UI-login credentials:
#   *_STORE_URL         WooCommerce site URL
#   *_EMAIL             WP.com or site-account login email/user
#   *_PASSWORD          password/application password for app login
#
# The runner copies the selected store block into the generic variables used
# by YAML.

# Lab store: disposable Jurassic Ninja instance, automation-only.
MAESTRO_WOO_LAB_STORE_URL=
MAESTRO_WOO_LAB_EMAIL=
MAESTRO_WOO_LAB_PASSWORD=

# Shared store: long-lived staging store used by release signal runs.
MAESTRO_WOO_SHARED_STORE_URL=https://inpersonpayments.wpcomstaging.com/
MAESTRO_WOO_SHARED_EMAIL=
MAESTRO_WOO_SHARED_PASSWORD=

# Backward-compatible generic variables. Leave empty when using the lab/shared
# store blocks above; the runner populates these from --store automatically.
MAESTRO_WOO_STORE_URL=
MAESTRO_WOO_EMAIL=
MAESTRO_WOO_PASSWORD=


# ═════════════════════════════════════════════════════════════════════════
# OPTIONAL TEST FIXTURE SELECTORS
# ═════════════════════════════════════════════════════════════════════════
# The runner provides defaults for these. Override only when the selected
# test store uses a different sample catalog product.
#
# Variable product used by order creation. The default matches common
# WooCommerce sample data.
# MAESTRO_FIXTURE_VARIABLE_PRODUCT=V-Neck T-Shirt


# ═════════════════════════════════════════════════════════════════════════
# OPTIONAL FLOW-SPECIFIC VARIABLES
# ═════════════════════════════════════════════════════════════════════════
# Names match the iOS credential-setup page structure so both platforms
# stay aligned. Leave commented-out until the matching flow is added.

# ── P2: Login > Not a Woo store (login_not_woo_store.yaml) ──────────────
# Reuses WOO_EMAIL + WOO_PASSWORD — only the store URL differs.
MAESTRO_WOO_NOT_A_WOO_STORE_URL=https://notawoostore.wordpress.com/

# ── P2: Login > Wrong account for the store (login_wrong_account.yaml) ──
# Reuses WOO_EMAIL + WOO_PASSWORD — only the store URL differs. The
# primary account intentionally does NOT have access to this store.
MAESTRO_WOO_WRONG_ACCOUNT_STORE_URL=https://site-for-woocommerce12a3fasdf45dfs6789.mystagingwebsite.com/

# ── P2: Login > No Jetpack (login_no_jetpack.yaml) ──────────────────────
# Requires a Jurassic Ninja site with WooCommerce installed but NO
# Jetpack. Login uses site credentials (not WP.com). JN provisions a
# fresh admin user per site — copy the credentials JN hands back.
MAESTRO_WOO_JN_SITE_URL=
MAESTRO_WOO_JN_USERNAME=
MAESTRO_WOO_JN_PASSWORD=

# ── P2: Login > Passwordless login (WordPress.com passwordless account) ─
# Separate WP.com account (no password — magic-link only). Reading the
# magic link requires the Mailosaur API key.
# Account credentials and Mailosaur API key live in the canonical secret store.
# MAESTRO_WOO_PASSWORDLESS_STORE_URL=https://woomobilepasswordlesslogin.wpcomstaging.com/
# MAESTRO_WOO_PASSWORDLESS_EMAIL=woomobile@bakbmdyy.mailosaur.net
# MAESTRO_WOO_PASSWORDLESS_PASSWORD=
# MAESTRO_MAILOSAUR_API_KEY=

# ── P2: Login > Login with 2FA ──────────────────────────────────────────
# Use a dedicated test WP.com account with 2FA temporarily enabled; the
# 2FA code must be generated at run time (authenticator seed or TOTP lib).
# MAESTRO_WOO_2FA_EMAIL=
# MAESTRO_WOO_2FA_PASSWORD=
# MAESTRO_WOO_2FA_STORE_URL=
# MAESTRO_WOO_2FA_TOTP_SECRET=

# ── P2: Login > No Jetpack / Jetpack not connected ──────────────────────
# Requires a freshly-provisioned Jurassic Ninja site with WooCommerce but
# without Jetpack connected. Credentials are generated per JN site.
# MAESTRO_WOO_JN_STORE_URL=
# MAESTRO_WOO_JN_USERNAME=
# MAESTRO_WOO_JN_PASSWORD=

# ── P2: Login > Social login (Apple/Google) ─────────────────────────────
# Uses device-level Google/Apple accounts — no Maestro env vars needed.
